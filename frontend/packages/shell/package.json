{
  "name": "@rumahl/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./App": "./src/App.tsx",
    "./build-id": "./src/build-id.ts",
    "./i18n": "./src/i18n/index.tsx",
    "./embedded-snapshot": "./src/embedded-snapshot.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/verify-production-bundle.js",
    "dev": "vite",
    "dev:demo": "vite --mode demo --open /demo.html",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rumahl/contracts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
