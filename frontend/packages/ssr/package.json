{
  "name": "@rumahl/ssr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build --ssr src/render.tsx --outDir dist",
    "start": "node server.js",
    "test:smoke": "node scripts/smoke.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rumahl/contracts": "workspace:*",
    "@rumahl/shell": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
