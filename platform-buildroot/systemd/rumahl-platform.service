[Unit]
Description=rumahl local platform and browser gateway
Wants=rumahl-shell.service
After=local-fs.target rumahl-hosts.service rumahl-host-config.service rumahl-shell.service
RequiresMountsFor=/var/lib/rumahl
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=rumahl-platform
Group=rumahl-web
SupplementaryGroups=rumahl-ssr rumahl-runtime-control
StateDirectory=rumahl
StateDirectoryMode=0700
RuntimeDirectory=rumahl-platform
RuntimeDirectoryMode=0751
EnvironmentFile=/etc/rumahl/platform.env
ExecStart=/usr/bin/rumahl-platform-service serve
MemoryDenyWriteExecute=yes
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# The platform provisions account homes and app data on the data disk, so /home
# stays writable; installed apps still get a private directory under /apps.
ProtectHome=no
ReadWritePaths=/home /apps
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
