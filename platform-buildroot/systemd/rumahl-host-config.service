[Unit]
Description=rumahl privileged host configuration broker
Documentation=file:/usr/share/doc/rumahl/platform-buildroot.md
After=local-fs.target rumahl-hosts.service
Before=nginx.service
Wants=rumahl-hosts.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/rumahl-host-config \
  --socket /run/rumahl-host-config/control.sock \
  --state-dir /var/lib/rumahl-host \
  --app-conf-dir /run/nginx/rumahl-apps \
  --ports-file /run/rumahl-host/app-ports.json \
  --tls-dir /var/lib/rumahl-tls \
  --ca-dir /var/lib/rumahl-ca \
  --hosts-file /run/rumahl/hosts \
  --ips-file /run/rumahl/ips \
  --platform-user rumahl-platform \
  --socket-group rumahl-runtime-control
RuntimeDirectory=rumahl-host-config rumahl-host
RuntimeDirectoryMode=0750
StateDirectory=rumahl-host
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/nginx /run/rumahl-host /var/lib/rumahl-tls /var/lib/rumahl-host
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
