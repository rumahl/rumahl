RUMAHL_STATE_DIR=/var/lib/rumahl
RUMAHL_PUBLIC_ORIGIN=https://rumahl.home.arpa
RUMAHL_GATEWAY_SOCKET=/run/rumahl-platform/gateway.sock
RUMAHL_GATEWAY_SOCKET_ACCESS=group
RUMAHL_SSR_SOCKET=/run/rumahl-shell/ssr.sock
RUMAHL_CLIENT_BUILD=/usr/share/rumahl/frontend/packages/shell/dist/build-id.json
RUMAHL_LOCALE=de
RUMAHL_PASSWORD_BLOCKLIST=/etc/rumahl/password-blocklist.txt

# Per-installation app hosts require wildcard local DNS and TLS.
RUMAHL_APP_HOST_SUFFIX=apps.rumahl.home.arpa

# `rumahl-platform-service install-package PACKAGE_DIR` delegates container image
# import to the runtime supervisor over its authenticated image socket and stores
# OIDC client secrets under a TPM-sealed key. `serve` never reads these values.
# RUMAHL_RUNTIME_UID is the numeric UID of the rumahl-runtime supervisor account.
RUMAHL_RUNTIME_UID=990
RUMAHL_RUNTIME_CONTROL_SOCKET=/run/rumahl-runtime-supervisor/control.sock
RUMAHL_RUNTIME_SECRET_SOCKET=/run/rumahl-runtime-supervisor/secrets.sock
RUMAHL_RUNTIME_IMAGE_SOCKET=/run/rumahl-runtime-supervisor/images.sock
RUMAHL_PACKAGE_TRUST_STORE=/etc/rumahl/package-trust-store.json
RUMAHL_TPM2_EXECUTABLE=/usr/bin/tpm2_unseal
RUMAHL_SECRET_KEY_ID=root-1
RUMAHL_SECRET_KEY_OBJECT=/var/lib/rumahl-tpm/root-1.ctx
# Optional: TPM policy session for the sealed key.
# RUMAHL_SECRET_KEY_POLICY_SESSION=/var/lib/rumahl-tpm/root-1.policy
