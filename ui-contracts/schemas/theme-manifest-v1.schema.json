{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rumahl.com/ui/theme-manifest-v1.schema.json",
  "title": "rumahl Theme Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "uiContractVersion", "id", "name"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "uiContractVersion": { "const": 1 },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*(\\.[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "properties": {
        "color.canvas.background": { "$ref": "#/$defs/color" },
        "color.panel.background": { "$ref": "#/$defs/color" },
        "color.text.primary": { "$ref": "#/$defs/color" },
        "color.text.muted": { "$ref": "#/$defs/color" },
        "color.accent.primary": { "$ref": "#/$defs/color" },
        "color.window.titlebar.background": { "$ref": "#/$defs/color" },
        "color.window.titlebar.foreground": { "$ref": "#/$defs/color" },
        "radius.window": { "$ref": "#/$defs/length" },
        "space.shell.gap": { "$ref": "#/$defs/length" },
        "color.accent": { "$ref": "#/$defs/colorAlpha" },
        "color.accent.strong": { "$ref": "#/$defs/colorAlpha" },
        "color.surface": { "$ref": "#/$defs/colorAlpha" },
        "color.surface.strong": { "$ref": "#/$defs/colorAlpha" },
        "color.outline": { "$ref": "#/$defs/colorAlpha" },
        "color.on.wallpaper": { "$ref": "#/$defs/colorAlpha" },
        "color.on.accent": { "$ref": "#/$defs/colorAlpha" },
        "color.shadow": { "$ref": "#/$defs/colorAlpha" },
        "material.blur": { "$ref": "#/$defs/length" },
        "material.saturation": { "$ref": "#/$defs/cssValue" },
        "material.opacity": { "$ref": "#/$defs/cssValue" },
        "shape.radius.dock": { "$ref": "#/$defs/length" },
        "shape.radius.icon": { "$ref": "#/$defs/length" },
        "shape.icon.size": { "$ref": "#/$defs/length" },
        "shape.icon.size.large": { "$ref": "#/$defs/length" },
        "motion.duration": { "$ref": "#/$defs/duration" },
        "motion.duration.fast": { "$ref": "#/$defs/duration" },
        "motion.easing.spring": { "$ref": "#/$defs/cssValue" },
        "layout.dock.offset": { "$ref": "#/$defs/length" },
        "icon.gradient": { "$ref": "#/$defs/cssValue" },
        "texture.wallpaper": { "$ref": "#/$defs/cssValue" },
        "typography.family": { "$ref": "#/$defs/cssValue" },
        "typography.scale": { "$ref": "#/$defs/cssValue" }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 16,
      "properties": {
        "window.chrome": { "enum": ["standard", "compact"] }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "colorAlpha": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "length": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]?|[0-9]{3})px$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})ms$"
    },
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^;{}\\\\<>@]+$"
    }
  }
}
