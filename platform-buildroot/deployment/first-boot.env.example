# Development and acceptance only: unattended first-boot setup. Omit this file
# on a real device to use the interactive console wizard instead.
FIRST_BOOT_USER=alice
FIRST_BOOT_DISPLAY=Alice
FIRST_BOOT_HOSTNAME=rumahl
FIRST_BOOT_PASSWORD=replace-with-a-strong-password

# Optional Wi-Fi for the first boot (iwd profile; simple SSIDs only).
# FIRST_BOOT_WIFI_SSID=example
# FIRST_BOOT_WIFI_PASSWORD=replace-with-the-wifi-password
