{
  "name": "rumahl-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "assets:update": "node ../scripts/fetch-assets.mjs && node ../scripts/sync-assets.mjs",
    "build": "pnpm --filter @rumahl/shell build && pnpm --filter @rumahl/ssr build",
    "dev": "pnpm --filter @rumahl/ssr dev",
    "dev:demo": "pnpm --filter @rumahl/shell dev:demo",
    "lint": "eslint .",
    "test": "pnpm --filter @rumahl/ui test && pnpm --filter @rumahl/shell test && pnpm --filter @rumahl/ssr test",
    "typecheck": "pnpm --filter @rumahl/ui typecheck && pnpm --filter @rumahl/shell typecheck && pnpm --filter @rumahl/ssr typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
