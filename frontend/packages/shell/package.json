{
  "name": "@rumahl/shell",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./App": "./src/App.tsx",
    "./ssr": "./src/ssr.ts",
    "./build-id": "./src/build-id.ts",
    "./i18n": "./src/i18n/index.tsx",
    "./embedded-snapshot": "./src/embedded-snapshot.ts"
  },
  "scripts": {
    "assets": "node ../../../scripts/fetch-assets.mjs && node ../../../scripts/sync-assets.mjs",
    "build": "pnpm assets && tsc --noEmit && vite build && node scripts/verify-production-bundle.js",
    "dev": "pnpm assets && vite",
    "dev:demo": "pnpm assets && vite --mode demo --open /demo.html",
    "test": "pnpm assets && vitest run --pool=threads --maxWorkers=1",
    "test:coverage": "pnpm assets && vitest run --pool=threads --maxWorkers=1 --coverage --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "typecheck": "pnpm assets && tsc --noEmit",
    "build:demo": "pnpm assets && vite build --mode demo && node scripts/prepare-demo-output.mjs demo",
    "build:demo-widget": "vite build --mode demo-widget && node scripts/prepare-demo-output.mjs demo-widget"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@rumahl/contracts": "workspace:*",
    "@rumahl/ui": "workspace:*",
    "motion": "^13.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "rollup-plugin-webpack-stats": "^4.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
