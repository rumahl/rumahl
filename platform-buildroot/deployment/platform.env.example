RUMAHL_STATE_DIR=/var/lib/rumahl
RUMAHL_PUBLIC_ORIGIN=https://rumahl.home.arpa
RUMAHL_GATEWAY_SOCKET=/run/rumahl-platform/gateway.sock
RUMAHL_GATEWAY_SOCKET_ACCESS=group
RUMAHL_SSR_SOCKET=/run/rumahl-shell/ssr.sock
RUMAHL_CLIENT_BUILD=/usr/share/rumahl/frontend/packages/shell/dist/build-id.json
RUMAHL_LOCALE=de
RUMAHL_PASSWORD_BLOCKLIST=/etc/rumahl/password-blocklist.txt
